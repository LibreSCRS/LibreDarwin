<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
SPDX-License-Identifier: LGPL-2.1-or-later
SPDX-FileCopyrightText: 2026 hirashix0

Embedded __info_plist for librescrs-agent (linked via
-Wl,-sectcreate,__TEXT,__info_plist,<this file>). A bare sandboxed main
executable needs its own CFBundleIdentifier for secinitd container keying —
without one, App Sandbox init SIGTRAPs in libsystem_secinit.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.librescrs.agent</string>
    <key>CFBundleName</key>
    <string>librescrs-agent</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
</dict>
</plist>
