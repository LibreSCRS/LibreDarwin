<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
SPDX-License-Identifier: LGPL-2.1-or-later
SPDX-FileCopyrightText: 2026 hirashix0

Template for the embedded __info_plist of librescrs-prompter: configure_file()
writes it into the build dir and the link line sectcreates THAT file. Same
secinitd container-keying requirement as the agent (see
agent/librescrs-agent-info.plist.in); LSUIElement keeps the AppKit run loop
dock- and menu-bar-less.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.librescrs.prompter</string>
    <key>CFBundleName</key>
    <string>librescrs-prompter</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
