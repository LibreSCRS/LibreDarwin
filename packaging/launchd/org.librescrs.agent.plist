<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: LGPL-2.1-or-later

  LaunchAgent for the macOS broker-host daemon (librescrs-agent). Bundled as a
  resource in the LibreMac host's Contents/Library/LaunchAgents/, where
  SMAppService.agent(plistName:) registers it (P4). No socket-activation, no
  per-user path templating.

  D7 (self-bind): the agent resolves the App-Group container socket at runtime
  ($HOME/Library/Group Containers/group.org.librescrs.LibreMac/agent.sock) and
  bind()s it itself, so there is NO Sockets key. SMAppService cannot carry a
  per-user SockPathName, which is precisely why socket-activation is off the
  modern path; self-bind resolves the conflict. The container does not exist
  until the sandboxed host first runs, so the host creates it (+ primes the CTK
  registration) and THEN registers/loads this agent.

  RunAtLoad + KeepAlive keep the agent up so it holds the CTK identity and
  observes card presence; it idles cheaply (the per-reader CardSessionHolder
  releases PC/SC after ~45 s).

  ProgramArguments points at the librescrs-agent inside the host bundle
  (Contents/MacOS). The dev harness (packaging/install-dev.sh) substitutes the
  installed libexec path for a standalone launchd smoke.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.librescrs.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>@LIBRESCRS_AGENT_PROGRAM@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
